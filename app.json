{
  "name": "hiimtaylorjones",
  "addons": [
    {
      "plan": "heroku-postgresql",
      "options": {
        "version": "16"
      }
    }
  ],
  "buildpacks": [
    {
      "url": "heroku/ruby"
    }
  ],
  "env": {
    "SECRET_TEST_PASSWORD": {
      "required": true
    },
    "RAILS_ENV": {
      "required": true
    }
  },
  "scripts": {
    "postdeploy": "bundle exec rake db:seed"
  },
  "environments": {
    "test": {
      "scripts": {
        "test": "bundle exec rspec spec"
      },
      "env": {
        "SECRET_TEST_PASSWORD": {
          "value": "test_me_out_1234"
        },
        "RAILS_ENV": {
          "value": "test"
        }
      }
    }
  }
}