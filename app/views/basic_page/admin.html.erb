<div class="admin-posts-index">
  <h1>Listing Posts</h1>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Title</th>
        <th>Collection</th>
        <th colspan="3">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @posts.each do |post| %>
        <tr>
          <td>
            <%= post.title %>
          </td>
          <td>
            <%= post.collection&.title || "—" %>
          </td>
          <td>
            <%= link_to 'Edit', edit_post_path(post), class: "warning-button" %>
          </td>
          <td>
            <%= button_to 'Destroy', post_path(post), class: "danger-button", method: :delete, data: { confirm: 'Are you sure?' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="has-text-centered mt-1">
    <%= link_to "New Post", new_post_path, class: "primary-button" %>
  </div>
</div>

<div class="admin-collections-index">
  <h1>Listing Collections</h1>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th>Title</th>
        <th>Posts</th>
        <th>Active</th>
        <th colspan="2">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @collections.each do |collection| %>
        <tr>
          <td>
            <%= link_to collection.title, collection_path(collection) %>
          </td>
          <td>
            <%= collection.posts.count %>
          </td>
          <td>
            <%= collection.active? ? "Yes" : "No" %>
          </td>
          <td>
            <%= link_to 'Edit', edit_collection_path(collection), class: "warning-button" %>
          </td>
          <td>
            <%= button_to 'Destroy', collection_path(collection), class: "danger-button", method: :delete, data: { confirm: 'Posts in this collection will be kept. Are you sure?' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="has-text-centered mt-1">
    <%= link_to "New Collection", new_collection_path, class: "primary-button" %>
  </div>
</div>
