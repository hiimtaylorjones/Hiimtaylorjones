<%= form_for @collection do |f| %>
  <% if @collection.errors.any? %>
  <div class="form-errors">
    <h2><%= pluralize(@collection.errors.count, "error") %> prohibited
      this collection from being saved:</h2>
    <ul>
    <% @collection.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, placeholder: "What ties these posts together?", class: "form-textarea", rows: 5 %>
  </div>

  <div class="form-checkbox">
    <%= f.label :active do %>
      <%= f.check_box :active %>
      Active — group these posts publicly
    <% end %>
  </div>

  <div class="form-group collection-posts">
    <%= f.label :post_ids, "Posts" %>
    <%# Drafts are listed too, so a post can be filed into a series before it goes live. %>
    <%= f.collection_check_boxes :post_ids, Post.includes(:collection).order(created_at: :desc), :id, :title do |b| %>
      <div class="form-checkbox">
        <%= b.label do %>
          <%= b.check_box %>
          <%= b.text %>
          <small>
            <%= b.object.published? ? "Published" : "Draft" %>
            <% if b.object.collection && b.object.collection != @collection %>
              · in "<%= b.object.collection.title %>"
            <% end %>
          </small>
        <% end %>
      </div>
    <% end %>
    <p><small>A post belongs to one collection, so checking a post filed elsewhere moves it here.</small></p>
  </div>

  <div class="form-actions">
    <%= link_to "Back", back_path, class: "primary-button" %>
    <%= f.submit class: "primary-button" %>
  </div>
<% end %>
