<div class="columns">
	<div class="column">
		<div class="post content">
			<div class="post-header">
				<% if post.banner_image.attached? %>
					<%= image_tag post.banner_image %>
				<% end %>
				<h1><%= link_to post.title, post_path(post) %></h1>
				<h3><i><%= post.tagline %></i></h3>
				<%# Date and collection on the left, the admin's Edit button on the right. %>
				<div class="post-meta">
					<div class="post-meta-details">
						<p>
							Written on <b><%= post.created_at.strftime("%B %d, %Y") %></b>
						</p>
						<%# An inactive collection's grouping does not apply, so a visitor sees
						    no collection at all. Admins see it, marked, for navigation. %>
						<% if post.collection.present? && (post.collection.active? || admin_signed_in?) %>
							<p>
								Part of <%= link_to post.collection.title, collection_path(post.collection) %>
								<% unless post.collection.active? %><i>(inactive)</i><% end %>
							</p>
						<% end %>
					</div>
					<% if admin_signed_in? %>
						<%= link_to 'Edit Post', edit_post_path(post.friendly_id), class: "button" %>
					<% end %>
				</div>
			</div>

			<div class="post-content center-block row">
				<%= markdown post.body %>
				<% if post.updated_at != post.created_at %>
					<p>Updated on <b><%= post.updated_at.strftime("%B %d, %Y") %></b></p>
				<% end %>
			</div>
		</div>
	</div>
</div>