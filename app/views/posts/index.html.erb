<% @posts.each do |post| %>
	<%= render 'posts/full_post', post: post%>
	<div class="content-divider"></div>
<% end %>

<%# Newest posts come first, so page 1 only offers older ones. %>
<div class="has-text-centered">
	<% if @page > 1 %>
		<%= link_to "Show Newer", posts_path(page: @page - 1), class: "button" %>
	<% end %>

	<% unless @at_last_page %>
		<%= link_to "Show Older", posts_path(page: @page + 1), class: "button" %>
	<% end %>
</div>
